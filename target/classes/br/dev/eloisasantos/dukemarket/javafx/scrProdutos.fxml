<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.dev.eloisasantos.dukemarket.javafx.ScrProdutosController">
    <stylesheets>
        <URL value="@scrprodutos.css" />
    </stylesheets>
   <children>
      <AnchorPane layoutX="14.0" layoutY="14.0" prefHeight="210.0" prefWidth="572.0">
         <children>
            <TableView fx:id="tblProduto" layoutY="-5.0" onMouseClicked="#tblProdutoOnMouseClicked" prefHeight="218.0" prefWidth="572.0">
              <columns>
                <TableColumn fx:id="tcoId" prefWidth="57.0" text="ID" />
                <TableColumn fx:id="tcoCodBarras" prefWidth="103.0" text="Cod.Barras" />
                  <TableColumn fx:id="tcoDescricao" prefWidth="107.0" text="Descrição" />
                  <TableColumn fx:id="tcoQtd" prefWidth="61.0" text="Qtd." />
                  <TableColumn fx:id="tcoValorCompra" prefWidth="85.0" text="\$ Compra" />
                  <TableColumn fx:id="tcoValorVenda" prefWidth="74.0" text="\$ Venda" />
                  <TableColumn fx:id="tcoDataCadastro" prefWidth="83.0" text="Data Cadastro" />
              </columns>
            </TableView>
         </children>
      </AnchorPane>
      <AnchorPane layoutX="415.0" layoutY="238.0" prefHeight="148.0" prefWidth="171.0">
         <children>
            <Button fx:id="btnNovo" layoutX="17.0" layoutY="40.0" mnemonicParsing="false" onAction="#btnNovoClick" prefHeight="25.0" prefWidth="138.0" text="Novo" />
            <Button fx:id="btnSalvar" layoutX="17.0" layoutY="74.0" mnemonicParsing="false" onAction="#btnSalvarClick" prefHeight="25.0" prefWidth="138.0" text="Salvar" />
            <Button fx:id="btnExcluir" layoutX="17.0" layoutY="109.0" mnemonicParsing="false" onAction="#btnExcluirClick" prefHeight="25.0" prefWidth="138.0" text="Excluir" />
         </children>
      </AnchorPane>
      <AnchorPane layoutX="14.0" layoutY="238.0" prefHeight="148.0" prefWidth="403.0">
         <children>
            <TextField fx:id="txtId" layoutX="61.0" layoutY="10.0" prefHeight="11.0" prefWidth="83.0" />
            <TextField fx:id="txtCodBarras" layoutX="248.0" layoutY="10.0" />
            <TextField fx:id="txtDescricao" layoutX="61.0" layoutY="36.0" prefHeight="25.0" prefWidth="335.0" />
            <TextField fx:id="txtQtd" layoutX="61.0" layoutY="62.0" prefHeight="25.0" prefWidth="114.0" />
            <TextField fx:id="txtValorCompra" layoutX="305.0" layoutY="63.0" prefHeight="25.0" prefWidth="92.0" />
            <TextField fx:id="txtValorVenda" layoutX="85.0" layoutY="90.0" prefHeight="25.0" prefWidth="92.0" />
            <DatePicker fx:id="dtpDataCadastro" layoutX="85.0" layoutY="124.0" prefHeight="25.0" prefWidth="171.0" />
            <Label layoutY="14.0" text="ID" />
            <Label layoutY="40.0" text="Descrição" />
            <Label layoutY="67.0" text="Qtd." />
            <Label layoutX="1.0" layoutY="94.0" text="Valor Venda" />
            <Label layoutX="1.0" layoutY="128.0" text="Data Cadastro" />
            <Label layoutX="172.0" layoutY="14.0" text="Cod. Barras" />
            <Label layoutX="219.0" layoutY="67.0" text="Valor Compra" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
